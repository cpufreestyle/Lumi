# ============================================
# Lumi - Apple MusicKit 配置
# ============================================

# === 必需：Apple Developer 凭据 ===
# 获取方式：https://developer.apple.com/account
# 1. 进入 Certificates, Identifiers & Profiles
# 2. 左侧 Keys → 创建 MusicKit Key
# 3. 下载 .p8 私钥文件，将其内容粘贴到下方

# Apple Developer Team ID (10位数字，在 https://developer.apple.com/account 右上角)
APPLE_TEAM_ID=

# MusicKit Key ID (10位字符，在 Keys 页面查看)
APPLE_KEY_ID=

# MusicKit .p8 私钥内容（将整个文件内容粘贴到此处，保持换行）
# 注意：每行开头不要有缩进
APPLE_PRIVATE_KEY=

# === 可选：服务配置 ===
PORT=3000
