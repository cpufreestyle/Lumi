{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "swift-test",
      "type": "shell",
      "command": "cd '${workspaceFolder}/Lumi' && export DEVELOPER_DIR=/Applications/Xcode.app/Contents/Developer && swift test",
      "group": { "kind": "test", "isDefault": true },
      "problemMatcher": [
        {
          "owner": "swift",
          "pattern": {
            "regexp": "^(.*):(\\d+):(\\d+):\\s+(error|warning|note):\\s+(.*)$",
            "file": 1, "line": 2, "column": 3, "severity": 4, "message": 5
          }
        }
      ],
      "presentation": { "echo": true, "reveal": "always", "focus": false, "panel": "shared" }
    }
  ]
}
