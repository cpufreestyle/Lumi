# Lumi 翻译配置(对齐 Mac 版 translate.env)
# 复制到 %APPDATA%/Lumi/translate.env (Windows) 或 ~/Library/Application Support/Lumi/translate.env (Mac)

# 默认后端为 Google 公开翻译(无需 key)。以下为可选增强后端。

# 阿里通义千问(可选):配置后设 LUMI_FORCE_LLM=1 优先使用,失败回退 Google
# LUMI_TRANSLATE_API_KEY=sk-xxxx
# LUMI_TRANSLATE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# LUMI_TRANSLATE_MODEL=qwen-plus
# LUMI_FORCE_LLM=1
