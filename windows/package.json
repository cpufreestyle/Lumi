{
  "name": "lumi-win",
  "version": "0.1.0",
  "description": "Lumi for Windows — 双语歌词 + 翻译 + 插件市场 (Electron)",
  "main": "dist/main.js",
  "author": "cpufreestyle",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build:renderer": "vite build",
    "build:main": "tsc -p tsconfig.main.json",
    "start": "npm run build:main && npm run build:renderer && electron .",
    "build:win": "npm run build:main && npm run build:renderer && electron-builder --win"
  },
  "dependencies": {
    "electron-updater": "^6.6.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "electron": "^43.0.0",
    "electron-builder": "^26.0.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "typescript": "^5.5.0",
    "vite": "^8.2.1"
  },
  "overrides": {
    "esbuild": ">=0.25.0"
  }
}
